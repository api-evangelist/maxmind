      "description": {
        "content": "Country-level IP geolocation lookup",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f109545d-5d55-4012-a74c-feab6f390f4f",
          "name": "GeoIP Country Lookup",
          "request": {
            "name": "GeoIP Country Lookup",
            "description": {
              "content": "Returns country-level geolocation data for a given IP address, including country name, ISO code, continent, and registered country. Suitable for geo-targeting, content localization, and compliance use cases where city precision is not required. Billed at $0.0001 per lookup.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "geoip",
                "v2.1",
                "country",
                ":ipAddress"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ipAddress",
                  "description": "(Required) The IP address you want to look up. Use \"me\" to look up the IP address of the current connection. Accepts IPv4 (dotted quad) or IPv6 (canonical form per RFC 5952).\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
