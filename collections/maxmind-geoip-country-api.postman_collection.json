  "info": {
    "_postman_id": "78c8ebd0-bc6b-48f5-ae27-bff6ee03a753",
    "name": "MaxMind GeoIP Web Services GeoIP City GeoIP Country API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "MaxMind's GeoIP web services provide IP geolocation data including country, city, ISP, organization, ASN, connection type, and VPN/proxy detection. Services are available at three tiers: Country, City Plus, and Insights. All endpoints use HTTP Basic Auth with your MaxMind account ID and license key.\n\n\nContact Support:\n Name: MaxMind Support",
      "type": "text/plain"
    }
  }
